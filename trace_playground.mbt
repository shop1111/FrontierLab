    #|$('load').onclick=load;$('validExample').onclick=()=>{$('caseSelect').value='correct';$('caseSelect').onchange({target:$('caseSelect')});load()};$('faultyExample').onclick=()=>{$('caseSelect').value='faulty';$('caseSelect').onchange({target:$('caseSelect')});load()};$('invalidExample').onclick=()=>{$('source').value=invalid;load()};$('runContract').onclick=runContract;$('findDivergence').onclick=()=>{try{const expected=parseExpected(),d=firstDivergence(expected,data);$('divergenceResult').textContent=d?d.message:'No divergence.';if(d)go(d.step)}catch(e){$('divergenceResult').textContent=e.message}};$('findBreakpoints').onclick=()=>{if(!data)return;const kind=$('bpEvent').value.trim(),target=$('bpTarget').value.trim(),role=$('bpRole').value.trim(),changed=$('bpChanged').checked,hits=data.steps.filter(s=>(!kind||s.event.type===kind)&&(!target||eventTargets(s.event).some(t=>`${t.object_id}/${t.entity_id||''}`.startsWith(target)))&&(!role||(s.scene.highlights||[]).some(h=>h.role===role))&&(!changed||sceneDiff(frame(data,s.index-1),s.scene).length));$('breakpointHits').replaceChildren(...(hits.length?hits.map(s=>{const b=el('button','',`step ${s.index}: ${s.event.type}`);b.onclick=()=>go(s.index);return b}):[el('p','muted','No breakpoint hits.')]))};
