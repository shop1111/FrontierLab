    #|$('caseSelect').onchange=event=>{if(event.target.value==='faulty'){$('source').value=JSON.stringify(actualFixture,null,2);$('expectedSource').value=JSON.stringify(expectedFixture,null,2);$('contract').value='sorted-int-sequence';$('contractObject').value='values'}else if(event.target.value==='correct'){$('source').value=JSON.stringify(expectedFixture,null,2);$('expectedSource').value=JSON.stringify(expectedFixture,null,2);$('contract').value='sorted-int-sequence';$('contractObject').value='values'}else{$('advanced').open=true;$('source').focus()}lastDiagnosis=null;setActions()};$('runDiagnosis').onclick=runDiagnosis;$('downloadCounterexample').onclick=()=>{if(!lastDiagnosis?.focused_slice)return;download('frontierlab-focused-slice.json','application/json',JSON.stringify(lastDiagnosis.focused_slice,null,2));$('actionStatus').textContent='Focused slice download created.'};$('downloadReport').onclick=()=>{if(!lastDiagnosis)return;download('frontierlab-diagnosis.html','text/html',reportHtml(lastDiagnosis));$('actionStatus').textContent='Offline diagnostic report created.'};$('copyRepair').onclick=async()=>{if(!lastDiagnosis)return;await copyText(repairPrompt(lastDiagnosis));$('actionStatus').textContent='Repair prompt copied.'};
    #|$('load').onclick=load;$('validExample').onclick=()=>{$('caseSelect').value='correct';$('caseSelect').onchange({target:$('caseSelect')});load()};$('faultyExample').onclick=()=>{$('caseSelect').value='faulty';$('caseSelect').onchange({target:$('caseSelect')});load()};$('invalidExample').onclick=()=>{$('source').value=invalid;load()};$('runContract').onclick=runContract;$('findDivergence').onclick=()=>{try{const expected=parseExpected(),result=firstDivergence(expected,data);$('divergenceResult').textContent=result?result.message:'No divergence.';if(result)go(result.step)}catch(error){$('divergenceResult').textContent=error.message}};$('findBreakpoints').onclick=()=>{if(!data)return;const kind=$('bpEvent').value.trim(),target=$('bpTarget').value.trim(),role=$('bpRole').value.trim(),changed=$('bpChanged').checked,hits=data.steps.filter(step=>(!kind||step.event.type===kind)&&(!target||eventTargets(step.event).some(value=>targetKey(value).startsWith(target)))&&(!role||(step.scene.highlights||[]).some(h=>h.role===role))&&(!changed||sceneDiff(frame(data,step.index-1),step.scene).length));$('breakpointHits').replaceChildren(...(hits.length?hits.map(step=>{const button=el('button','',`step ${step.index}: ${step.event.type}`);button.onclick=()=>go(step.index);return button}):[el('p','muted','No breakpoint hits.')]))};
    #|$('prev').onclick=()=>go(index-1);$('next').onclick=()=>go(index+1);$('range').oninput=event=>go(+event.target.value-1);$('play').onclick=()=>{if(!data)return;if(timer){stop();return}if(index>=data.steps.length-1)go(-1);$('play').textContent='Pause';timer=setInterval(()=>index>=data.steps.length-1?stop():go(index+1),+$('speed').value)};$('speed').onchange=()=>{if(timer){stop();$('play').click()}};$('downloadJson').onclick=()=>download('frontierlab-trace.json','application/json',$('source').value);$('downloadSvg').onclick=()=>{if(!data)return;const text=xmlEscape(`FrontierLab ${data.metadata.title} - step ${index}`);download('frontierlab-frame.svg','image/svg+xml',`<svg xmlns="http://www.w3.org/2000/svg" width="800" height="120"><rect width="100%" height="100%" fill="#f8fafc"/><text x="24" y="64" fill="#172033" font-family="system-ui" font-size="20">${text}</text></svg>`)};
    #|$('file').onchange=event=>read(event.target.files[0]);function read(file){if(!file)return;if(file.size>LIMITS.maxBytes){showErrors([`file: ${file.name} exceeds the 20 MiB browser limit; use the CLI/API`]);return}const reader=new FileReader();reader.onload=()=>{$('source').value=String(reader.result);$('caseSelect').value='custom';load()};reader.onerror=()=>showErrors(['file: unable to read the selected file']);reader.readAsText(file)}const drop=$('drop');for(const name of ['dragenter','dragover'])drop.addEventListener(name,event=>{event.preventDefault();drop.classList.add('over')});for(const name of ['dragleave','drop'])drop.addEventListener(name,event=>{event.preventDefault();drop.classList.remove('over')});drop.addEventListener('drop',event=>read(event.dataTransfer.files[0]));addEventListener('keydown',event=>{if(event.target===$('source')||event.target===$('expectedSource'))return;if(event.key==='ArrowLeft')go(index-1);if(event.key==='ArrowRight')go(index+1)});
    #|$('source').value=JSON.stringify(actualFixture,null,2);$('expectedSource').value=JSON.stringify(expectedFixture,null,2);setActions();load()})();
    #|</script></main></body></html>
  )
}
