    #|const roleMap=s=>Object.fromEntries((s.highlights||[]).map(h=>[`${h.target.object_id}/${h.target.entity_id||''}`,h.role])),el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n};function render(){if(!data){$('stage').replaceChildren(el('p','muted','Load a valid trace to begin.'));return}const s=frame(data,index),roles=roleMap(s),step=index<0?null:data.steps[index],objects=[];for(const o of s.objects||[]){const box=el('div',''),h=el('h3','',o.label||o.id);box.append(h);if(o.type==='sequence'){const row=el('div','sequence');for(const x of o.items){const item=el('div','item',x.value);item.dataset.role=roles[`${o.id}/${x.id}`]||'';item.append(el('small','',x.id));row.append(item)}box.append(row)}objects.push(box)}$('stage').replaceChildren(...objects);$('traceTitle').textContent=data.metadata.title;$('event').textContent=step?`Step ${index}: ${JSON.stringify(step.event)}`:'Initial scene';$('counter').textContent=`${index+1} / ${data.steps.length}`;$('range').value=index+1;[...$('timeline').children].forEach((n,i)=>n.classList.toggle('active',i===index+1));const changes=index<0?[]:sceneDiff(frame(data,index-1),s);$('frameDiff').replaceChildren(...(changes.length?changes:[{kind:'none',target:'No semantic changes'}]).map(c=>el('div','',`${c.kind}: ${c.target}${c.before_index!==undefined?` (${c.before_index} -> ${c.after_index})`:''}`)))}
