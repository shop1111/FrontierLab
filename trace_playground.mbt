    #|<section class="panel" aria-labelledby="clinic-title"><h2 id="clinic-title">Find the first wrong step</h2><div class="toolbar"><label>Case <select id="caseSelect"><option value="faulty" selected>Faulty selection sort (step 10)</option><option value="correct">Correct selection sort</option><option value="custom">Custom imported trace</option></select></label><button id="runDiagnosis" class="primary">Run diagnosis</button><span id="clinicStatus" class="status muted">Ready: frozen consumer evidence is loaded.</span></div>
    #|<div class="summary-ribbon" aria-live="polite"><article class="metric"><h3>Schema</h3><strong id="schemaResult" class="muted">Not run</strong></article><article class="metric"><h3>Contract</h3><strong id="contractSummary" class="muted">Not run</strong></article><article class="metric"><h3>First divergence</h3><strong id="divergenceSummary" class="muted">Not run</strong></article><article class="metric"><h3>Focus</h3><strong id="focusSummary" class="muted">Not run</strong></article></div>
