      #|$('load').onclick=load;$('validExample').onclick=()=>{source.value=valid;load()};$('faultyExample').onclick=()=>{source.value=faultyTrace();load();$('contract').value='sequence-transition';$('contractObject').value='values'};$('invalidExample').onclick=()=>{source.value=invalid;load()};$('file').onchange=e=>read(e.target.files[0]);function read(f){if(!f)return;const r=new FileReader();r.onload=()=>{source.value=String(r.result);load()};r.onerror=()=>showErrors(['file: unable to read the selected file']);r.readAsText(f)}const drop=$('drop');for(const n of ['dragenter','dragover'])drop.addEventListener(n,e=>{e.preventDefault();drop.classList.add('over')});for(const n of ['dragleave','drop'])drop.addEventListener(n,e=>{e.preventDefault();drop.classList.remove('over')});drop.addEventListener('drop',e=>read(e.dataTransfer.files[0]));addEventListener('keydown',e=>{if(e.target===source||e.target===$('expectedSource'))return;if(e.key==='ArrowLeft')go(index-1);if(e.key==='ArrowRight')go(index+1)});load()})();
