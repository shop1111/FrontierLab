    #|function eventTargets(e){return e?.targets||[e?.target,e?.left,e?.right,e?.from,e?.to].filter(Boolean)}function entityRows(o){if(o.type==='sequence')return(o.items||[]).map((x,i)=>[x.id,x.value,i]);if(o.type==='sets')return(o.groups||[]).map((x,i)=>[x.id,`${x.label}:${(x.members||[]).join(',')}`,i]);if(o.type==='graph')return[...(o.nodes||[]).map((x,i)=>[x.id,x.label,i]),...(o.edges||[]).map((x,i)=>[`edge:${x.id}`,`${x.from}->${x.to}:${x.label}:${!!x.directed}`,i+(o.nodes||[]).length])];if(o.type==='grid')return(o.cells||[]).map((x,i)=>[x.id,`${x.x},${x.y}:${x.label||''}:${!!x.blocked}`,i]);return[]}function targetIds(o){if(o.type==='sequence')return(o.items||[]).map(x=>x.id);if(o.type==='sets')return(o.groups||[]).flatMap(x=>[x.id,...(x.members||[])]);if(o.type==='graph')return[...(o.nodes||[]).map(x=>x.id),...(o.edges||[]).map(x=>x.id)];if(o.type==='grid')return(o.cells||[]).map(x=>x.id);return[]}
    #|function validate(d){const errors=[],err=(path,message)=>errors.push(`${path}: ${message}`),str=(value,path)=>{if(typeof value!=='string')err(path,'expected a string')},arr=(value,path)=>{if(!Array.isArray(value))err(path,'expected an array')},unique=(values,path,kind)=>{const seen=new Set();for(const value of values){if(seen.has(value))err(path,`duplicate ${kind} id ${value}`);seen.add(value)}};if(!isObject(d)){err('$','expected an object');return errors}if(d.format!=='frontierlab-trace')err('$.format','expected "frontierlab-trace"');if(d.schema_version!=='1.0')err('$.schema_version','expected "1.0"');if(!isObject(d.metadata))err('$.metadata','expected an object');else{str(d.metadata.title,'$.metadata.title');str(d.metadata.algorithm,'$.metadata.algorithm');str(d.metadata.description,'$.metadata.description')}function sceneErrors(scene,path){if(!isObject(scene)){err(path,'expected a scene object');return}arr(scene.objects,`${path}.objects`);arr(scene.highlights,`${path}.highlights`);if(!Array.isArray(scene.objects)||!Array.isArray(scene.highlights))return;unique(scene.objects.map(x=>x?.id),`${path}.objects`,'scene object');let entityCount=scene.objects.length;const byId=new Map();scene.objects.forEach((o,i)=>{const at=`${path}.objects[${i}]`;if(!isObject(o)){err(at,'expected an object');return}str(o.id,`${at}.id`);str(o.label,`${at}.label`);byId.set(o.id,o);if(o.type==='sequence'){arr(o.items,`${at}.items`);if(Array.isArray(o.items)){unique(o.items.map(x=>x?.id),`${at}.items`,'sequence entity');entityCount+=o.items.length;o.items.forEach((x,j)=>{str(x?.id,`${at}.items[${j}].id`);str(x?.value,`${at}.items[${j}].value`)})}}else if(o.type==='sets'){arr(o.groups,`${at}.groups`);if(Array.isArray(o.groups)){unique(o.groups.map(x=>x?.id),`${at}.groups`,'set group');const members=[];for(const [j,g] of o.groups.entries()){str(g?.id,`${at}.groups[${j}].id`);str(g?.label,`${at}.groups[${j}].label`);arr(g?.members,`${at}.groups[${j}].members`);if(Array.isArray(g?.members)){g.members.forEach((m,k)=>str(m,`${at}.groups[${j}].members[${k}]`));members.push(...g.members);entityCount+=1+g.members.length}}unique(members,`${at}.groups`,'set member')}}else if(o.type==='graph'){arr(o.nodes,`${at}.nodes`);arr(o.edges,`${at}.edges`);if(Array.isArray(o.nodes)&&Array.isArray(o.edges)){unique(o.nodes.map(x=>x?.id),`${at}.nodes`,'graph node');unique(o.edges.map(x=>x?.id),`${at}.edges`,'graph edge');const nodes=new Set(o.nodes.map(x=>x?.id));o.nodes.forEach((x,j)=>{str(x?.id,`${at}.nodes[${j}].id`);str(x?.label,`${at}.nodes[${j}].label`)});o.edges.forEach((x,j)=>{str(x?.id,`${at}.edges[${j}].id`);str(x?.from,`${at}.edges[${j}].from`);str(x?.to,`${at}.edges[${j}].to`);str(x?.label,`${at}.edges[${j}].label`);if(typeof x?.directed!=='boolean')err(`${at}.edges[${j}].directed`,'expected a boolean');if(!nodes.has(x?.from)||!nodes.has(x?.to))err(`${at}.edges[${j}]`,'edge endpoints must reference existing node ids')});entityCount+=o.nodes.length+o.edges.length}}else if(o.type==='grid'){if(!Number.isInteger(o.width)||o.width<=0||!Number.isInteger(o.height)||o.height<=0)err(at,'grid dimensions must be positive integers');arr(o.cells,`${at}.cells`);if(Array.isArray(o.cells)){unique(o.cells.map(x=>x?.id),`${at}.cells`,'grid cell');o.cells.forEach((x,j)=>{str(x?.id,`${at}.cells[${j}].id`);str(x?.label,`${at}.cells[${j}].label`);if(typeof x?.blocked!=='boolean')err(`${at}.cells[${j}].blocked`,'expected a boolean');if(!Number.isInteger(x?.x)||!Number.isInteger(x?.y)||x.x<0||x.y<0||x.x>=o.width||x.y>=o.height)err(`${at}.cells[${j}]`,'cell is outside grid dimensions')});entityCount+=o.cells.length}}else err(`${at}.type`,`unknown scene object type ${o.type}`)});if(entityCount>LIMITS.maxEntities)err(path,`scene entity limit exceeded (${entityCount}/${LIMITS.maxEntities})`);const contains=t=>{const object=byId.get(t?.object_id);return!!object&&(t?.entity_id===undefined||targetIds(object).includes(t.entity_id))};scene.highlights.forEach((h,i)=>{const at=`${path}.highli