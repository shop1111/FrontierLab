      #|const refKey=r=>`${r.object_id}::${r.entity_id||''}`;const roles=s=>Object.fromEntries((s.highlights||[]).map(h=>[refKey(h.target),h.role]));const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n};
      #|function renderObject(o,r){const w=el('div','object'),h=el('h3','',o.label||o.id||o.type);w.append(h);if(o.type==='sequence'){const row=el('div','sequence');for(const x of o.items||[]){const n=el('div','item',x.value);n.dataset.role=r[`${o.id}::${x.id}`]||'';n.append(el('small','',x.id));row.append(n)}w.append(row)}else if(o.type==='sets'){const rows=el('div','groups');for(const g of o.groups||[]){const n=el('div','group',`${g.label||g.id}: ${(g.members||[]).join(', ')}`);n.dataset.role=r[`${o.id}::${g.id}`]||'';rows.append(n)}w.append(rows)}else if(o.type==='grid'){const g=el('div','grid');g.style.gridTemplateColumns=`repeat(${o.width},40px)`;for(const c of [...(o.cells||[])].sort((a,b)=>a.y-b.y||a.x-b.x)){const n=el('div',`cell${c.blocked?' blocked':''}`,c.label||'');n.dataset.role=r[`${o.id}::${c.id}`]||'';g.append(n)}w.append(g)}else if(o.type==='graph'){const row=el('div','sequence');for(const x of o.nodes||[]){const n=el('div','node',x.label||x.id);n.dataset.role=r[`${o.id}::${x.id}`]||'';row.append(n)}w.append(row)}return w}
      #|function render(){if(!data){$('stage').replaceChildren(el('p','muted','Load a valid trace to begin.'));return}const s=index<0?data.initial_scene:data.steps[index].scene,r=roles(s),step=index<0?null:data.steps[index];$('stage').replaceChildren(...s.objects.map(o=>renderObject(o,r)));$('event').textContent=step?`Step ${index}: ${JSON.stringify(step.event)}`:'Initial scene';$('counter').textContent=`${index+1} / ${data.steps.length}`;$('range').value=index+1;[...$('timeline').children].forEach((n,i)=>n.classList.toggle('active',i===index+1));$('prev').disabled=index<0;$('next').disabled=index>=data.steps.length-1;const changes=index<0?[]:sceneDiff(frame(data,index-1),s);$('frameDiff').replaceChildren(...(changes.length?changes:[{kind:'none',target:'No semantic changes'}]).map(c=>el('button','',`${c.kind}: ${c.target}${c.before!==undefined?` | ${c.before} → ${c.after}`:''}${c.before_index!==undefined?` | ${c.before_index} → ${c.after_index}`:''}`)))}
