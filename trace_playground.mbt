///|
/// Render a self-contained offline playground for importing, validating,
/// analyzing, replaying, and exporting schema-v1 trace documents.
pub fn render_trace_playground() -> String raise TraceError {
  let example = insertion_sort_trace([5, 2, 4, 1, 3])
  let safe_example = example.encode_json().replace_all(old="<", new="\\u003c")
  let out = StringBuilder()
  out.write_string(
    (
      #|<!doctype html>
      #|<html lang="en"><head><meta charset="utf-8">
      #|<meta name="viewport" content="width=device-width,initial-scale=1">
      #|<title>FrontierLab Trace Playground</title>
      #|<style>
      #|:root{color-scheme:light dark;--bg:#f8fafc;--panel:#fff;--ink:#0f172a;--muted:#64748b;--line:#cbd5e1;--accent:#2563eb;--bad:#dc2626;--good:#15803d}
      #|@media(prefers-color-scheme:dark){:root{--bg:#07111f;--panel:#0f172a;--ink:#f8fafc;--muted:#94a3b8;--line:#334155;--accent:#60a5fa;--bad:#f87171;--good:#4ade80}}
      #|*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,sans-serif}main{max-width:1280px;margin:auto;padding:24px}h1{margin:.1em 0;font-size:clamp(30px,6vw,56px)}h2,h3{margin:.25em 0}.muted{color:var(--muted)}.toolbar,.controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px;margin-top:16px}.split{display:grid;grid-template-columns:minmax(300px,1fr) minmax(360px,1.35fr);gap:16px}.drop{border:2px dashed var(--line);border-radius:12px;padding:12px;text-align:center}.drop.over{border-color:var(--accent)}textarea{width:100%;min-height:330px;resize:vertical;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:12px;font:12px/1.45 ui-monospace,monospace}button,input,select{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:8px 11px}button{cursor:pointer}button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}button:hover{border-color:var(--accent)}input[type=range]{flex:1;min-width:150px;accent-color:var(--accent)}.status{font-weight:700}.ok{color:var(--good)}.bad{color:var(--bad)}.errors{white-space:pre-wrap;color:var(--bad);font:13px/1.45 ui-monospace,monospace}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:9px;margin-top:12px}.card{border:1px solid var(--line);border-radius:11px;padding:10px}.card strong{display:block;font-size:22px}.badges{display:flex;gap:7px;flex-wrap:wrap}.badge{border:1px solid var(--line);border-radius:99px;padding:3px 8px;color:var(--muted)}#stage{min-height:280px;display:grid;gap:16px}.object h3{margin-bottom:9px}.sequence{display:flex;gap:9px;flex-wrap:wrap}.item,.group,.cell,.node{border:2px solid var(--line);border-radius:9px;padding:10px;text-align:center}.item{min-width:54px}.item small{display:block;color:var(--muted)}.groups{display:grid;gap:7px}.grid{display:grid;gap:3px;width:max-content}.cell{width:40px;height:40px;padding:7px}.blocked{background:#334155;color:white}[data-role=current]{background:#f59e0b}[data-role=candidate]{background:#38bdf8}[data-role=compared]{background:#c084fc}[data-role=changed]{background:#fb7185}[data-role=visited]{background:#93c5fd}[data-role=frontier]{background:#22d3ee}[data-role=result]{background:#4ade80}[data-role=error]{background:#ef4444}.timeline{max-height:220px;overflow:auto;font:13px/1.5 ui-monospace,monospace}.timeline div.active{color:var(--accent);font-weight:700}.quality li{margin:4px 0}@media(max-width:850px){.split{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
      #|</style></head><body><main>
      #|<a href="index.html">← FrontierLab demos</a><h1>Trace Playground</h1><p class="muted">Import a <code>frontierlab-trace</code> schema-v1 JSON document. Everything stays in this browser; no network request or CDN is used.</p>
      #|<div class="split"><section class="panel"><div id="drop" class="drop">Drop a JSON file here or choose one <input id="file" type="file" accept=".json,application/json"></div><textarea id="source" spellcheck="false" aria-label="Trace JSON"></textarea><div class="toolbar"><button id="load" class="primary">Validate &amp; load</button><button id="validExample">Valid example</button><button id="invalidExample">Invalid example</button><button id="downloadJson">Download JSON</button></div><p id="status" class="status"></p><div id="errors" class="errors"></div></section>
      #|<section><section class="panel"><div class="controls"><button id="prev">← Prev</button><button id="play">Play</button><button id="next">Next →</button><input id="range" type="range" min="0" value="0"><select id="speed"><option value="1200">0.5×</option><option value="650" selected>1×</option><option value="300">2×</option></select><output id="counter"></output><button id="downloadSvg">Export current SVG</button></div></section><section id="stage" class="panel" aria-live="polite"></section><section class="panel"><h2 id="traceTitle">No trace loaded</h2><p id="event" class="muted"></p><div id="eventBadges" class="badges"></div><div id="cards" class="cards"></div></section></section></div>
      #|<div class="split"><section class="panel"><h2>Quality diagnostics</h2><ul id="quality" class="quality"></ul></section><section class="panel"><h2>Timeline</h2><div id="timeline" class="timeline"></div></section></div>
      #|<script id="valid-data" type="application/json">
    ),
  )
  out.write_string(safe_example)
  out.write_string(
    (
      #|</script><script>
      #|(()=>{'use strict';const $=id=>document.getElementById(id),source=$('source');let data=null,index=-1,timer=null;const valid=$('valid-data').textContent.trim();const invalid='{"schema_version":"1.0","metadata":{"title":"Broken"},"steps":[{"index":3}]}';source.value=valid;
      #|const err=(a,p,m)=>a.push(`${p}: ${m}`);function validate(d){const e=[];if(!d||typeof d!=='object'||Array.isArray(d)){err(e,'$','expected an object');return e}if(d.schema_version!=='1.0')err(e,'$.schema_version','expected "1.0"');if(!d.metadata||typeof d.metadata!=='object')err(e,'$.metadata','missing metadata object');else{if(typeof d.metadata.title!=='string'||!d.metadata.title.trim())err(e,'$.metadata.title','expected a non-empty string');if(typeof d.metadata.algorithm!=='string'||!d.metadata.algorithm.trim())err(e,'$.metadata.algorithm','expected a non-empty string')}sceneErrors(d.initial_scene,'$.initial_scene',e);if(!Array.isArray(d.steps))err(e,'$.steps','expected an array');else d.steps.forEach((s,i)=>{if(!s||typeof s!=='object'){err(e,`$.steps[${i}]`,'expected an object');return}if(s.index!==i)err(e,`$.steps[${i}].index`,`expected ${i}`);if(!s.event||typeof s.event.type!=='string')err(e,`$.steps[${i}].event.type`,'expected an event type');sceneErrors(s.scene,`$.steps[${i}].scene`,e)});return e}
      #|function sceneErrors(s,p,e){if(!s||typeof s!=='object'){err(e,p,'expected a scene object');return}if(!Array.isArray(s.objects))err(e,p+'.objects','expected an array');if(s.highlights!==undefined&&!Array.isArray(s.highlights))err(e,p+'.highlights','expected an array')}
      #|function eventTargets(ev){if(!ev)return[];return ev.targets||[ev.target,ev.left,ev.right,ev.from,ev.to].filter(Boolean)}function entities(o){return o.items?.length||o.groups?.length||o.nodes?.length||o.cells?.length||0}function analyze(d){const counts={},targets={};let maxObjects=d.initial_scene.objects.length,maxEntities=d.initial_scene.objects.reduce((n,o)=>n+entities(o),0),annotations=0,highlights=(d.initial_scene.highlights||[]).length;for(const s of d.steps){counts[s.event.type]=(counts[s.event.type]||0)+1;for(const t of eventTargets(s.event)){const k=`${t.object_id}/${t.entity_id||'*'}`;targets[k]=(targets[k]||0)+1}maxObjects=Math.max(maxObjects,s.scene.objects.length);maxEntities=Math.max(maxEntities,s.scene.objects.reduce((n,o)=>n+entities(o),0));annotations+=s.annotation?1:0;highlights+=(s.scene.highlights||[]).length}return{counts,targets,maxObjects,maxEntities,annotations,highlights,completed:d.steps.at(-1)?.event?.type==='complete'}}
      #|function lint(d){const q=[];if(!d.initial_scene.objects.length)q.push(['warning','Initial scene has no renderable objects.']);if(!d.steps.length)q.push(['warning','Trace has no recorded steps.']);else if(d.steps.at(-1).event.type!=='complete')q.push(['warning','The final event is not complete.']);if(!d.summary||!Object.keys(d.summary).length)q.push(['info','Trace has no summary attributes.']);d.steps.forEach((s,i)=>{if(!s.annotation&&s.event.type!=='complete')q.push(['info',`Step ${i} has no teaching annotation.`]);if(!s.scene.objects.length)q.push(['warning',`Step ${i} has an empty scene.`])});return q}
      #|const refKey=r=>`${r.object_id}::${r.entity_id||''}`;const roles=s=>Object.fromEntries((s.highlights||[]).map(h=>[refKey(h.target),h.role]));const el=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n};
      #|function renderObject(o,r){const w=el('div','object'),h=el('h3','',o.label||o.id||o.type);w.append(h);if(o.type==='sequence'){const row=el('div','sequence');for(const x of o.items||[]){const n=el('div','item',x.value);n.dataset.role=r[`${o.id}::${x.id}`]||'';n.append(el('small','',x.id));row.append(n)}w.append(row)}else if(o.type==='sets'){const rows=el('div','groups');for(const g of o.groups||[]){const n=el('div','group',`${g.label||g.id}: ${(g.members||[]).join(', ')}`);n.dataset.role=r[`${o.id}::${g.id}`]||'';rows.append(n)}w.append(rows)}else if(o.type==='grid'){const g=el('div','grid');g.style.gridTemplateColumns=`repeat(${o.width},40px)`;for(const c of [...(o.cells||[])].sort((a,b)=>a.y-b.y||a.x-b.x)){const n=el('div',`cell${c.blocked?' blocked':''}`,c.label||'');n.dataset.role=r[`${o.id}::${c.id}`]||'';g.append(n)}w.append(g)}else if(o.type==='graph'){const row=el('div','sequence');for(const x of o.nodes||[]){const n=el('div','node',x.label||x.id);n.dataset.role=r[`${o.id}::${x.id}`]||'';row.append(n)}w.append(row)}return w}
      #|function render(){if(!data){$('stage').replaceChildren(el('p','muted','Load a valid trace to begin.'));return}const s=index<0?data.initial_scene:data.steps[index].scene,r=roles(s),step=index<0?null:data.steps[index];$('stage').replaceChildren(...s.objects.map(o=>renderObject(o,r)));$('event').textContent=step?`Step ${index}: ${JSON.stringify(step.event)}`:'Initial scene';$('counter').textContent=`${index+1} / ${data.steps.length}`;$('range').value=index+1;[...$('timeline').children].forEach((n,i)=>n.classList.toggle('active',i===index+1));$('prev').disabled=index<0;$('next').disabled=index>=data.steps.length-1}
      #|function load(){let d;try{d=JSON.parse(source.value)}catch(x){showErrors([`JSON: ${x.message}`]);return}const e=validate(d);if(e.length){showErrors(e);return}data=d;index=-1;stop();$('status').className='status ok';$('status').textContent='Valid schema-v1 trace loaded.';$('errors').textContent='';$('traceTitle').textContent=d.metadata.title;$('range').max=d.steps.length;const a=analyze(d),items=[['Steps',d.steps.length],['Event kinds',Object.keys(a.counts).length],['Max objects',a.maxObjects],['Max entities',a.maxEntities],['Annotations',a.annotations],['Highlights',a.highlights],['Completed',a.completed?'yes':'no']];$('cards').replaceChildren(...items.map(([k,v])=>{const n=el('div','card');n.append(el('span','muted',k),el('strong','',String(v)));return n}));$('eventBadges').replaceChildren(...Object.entries(a.counts).map(([k,v])=>el('span','badge',`${k}: ${v}`)));const q=lint(d);$('quality').replaceChildren(...(q.length?q:[['info','No trace quality issues.']]).map(([s,m])=>el('li',s==='warning'?'bad':'',`[${s}] ${m}`)));$('timeline').replaceChildren(el('div','','initial | objects='+d.initial_scene.objects.length),...d.steps.map(s=>el('div','',`step ${s.index} | ${s.event.type} | objects=${s.scene.objects.length}${s.annotation?' | '+s.annotation.title:''}`)));render()}
      #|function showErrors(e){data=null;stop();$('status').className='status bad';$('status').textContent=`Invalid trace (${e.length} issue${e.length===1?'':'s'}).`;$('errors').textContent=e.join('\n');$('traceTitle').textContent='No trace loaded';$('cards').replaceChildren();$('quality').replaceChildren();$('timeline').replaceChildren();render()}
      #|function go(n){if(!data)return;index=Math.max(-1,Math.min(data.steps.length-1,n));render()}function stop(){clearInterval(timer);timer=null;$('play').textContent='Play'}$('prev').onclick=()=>go(index-1);$('next').onclick=()=>go(index+1);$('range').oninput=e=>go(+e.target.value-1);$('play').onclick=()=>{if(!data)return;if(timer){stop();return}if(index>=data.steps.length-1)go(-1);$('play').textContent='Pause';timer=setInterval(()=>index>=data.steps.length-1?stop():go(index+1),+$('speed').value)};$('speed').onchange=()=>{if(timer){stop();$('play').click()}};
      #|function download(name,type,text){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),0)}$('downloadJson').onclick=()=>download('frontierlab-trace.json','application/json',source.value);$('downloadSvg').onclick=()=>{if(!data)return;const scene=index<0?data.initial_scene:data.steps[index].scene,lines=[`FrontierLab: ${data.metadata.title}`,`Frame: ${index<0?'initial':index}`,`Objects: ${scene.objects.length}`,...scene.objects.map(o=>`${o.type}: ${o.label||o.id} (${entities(o)} entities)`)],body=lines.map((x,i)=>`<text x="24" y="${38+i*28}" fill="#0f172a" font-family="system-ui" font-size="16">${String(x).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}</text>`).join('');download('frontierlab-frame.svg','image/svg+xml',`<svg xmlns="http://www.w3.org/2000/svg" width="800" height="${70+lines.length*28}" viewBox="0 0 800 ${70+lines.length*28}"><rect width="100%" height="100%" fill="#f8fafc"/>${body}</svg>`)};
      #|$('load').onclick=load;$('validExample').onclick=()=>{source.value=valid;load()};$('invalidExample').onclick=()=>{source.value=invalid;load()};$('file').onchange=e=>read(e.target.files[0]);function read(f){if(!f)return;const r=new FileReader();r.onload=()=>{source.value=String(r.result);load()};r.onerror=()=>showErrors(['file: unable to read the selected file']);r.readAsText(f)}const drop=$('drop');for(const n of ['dragenter','dragover'])drop.addEventListener(n,e=>{e.preventDefault();drop.classList.add('over')});for(const n of ['dragleave','drop'])drop.addEventListener(n,e=>{e.preventDefault();drop.classList.remove('over')});drop.addEventListener('drop',e=>read(e.dataTransfer.files[0]));addEventListener('keydown',e=>{if(e.target===source)return;if(e.key==='ArrowLeft')go(index-1);if(e.key==='ArrowRight')go(index+1)});load()})();
      #|</script></main></body></html>
    ),
  )
  out.to_string()
}
