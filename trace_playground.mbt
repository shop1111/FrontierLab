    #|*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,sans-serif}main{max-width:1180px;margin:auto;padding:24px;overflow:hidden}h1{margin:.08em 0;font-size:clamp(42px,7vw,72px);letter-spacing:-.055em}h2,h3{margin:.2em 0}.hero{padding:34px 0 14px}.eyebrow{color:var(--accent);font-weight:800;text-transform:uppercase;letter-spacing:.12em}.lead{max-width:840px;font-size:18px}.muted{color:var(--muted)}.panel{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;margin-top:16px;box-shadow:0 14px 40px #1111}.toolbar,.controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar>*{max-width:100%}button,input,select{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px}button{cursor:pointer;font-weight:700}button.primary{background:var(--accent);border-color:var(--accent);color:white}button:hover:not(:disabled){border-color:var(--accent)}button:disabled{cursor:not-allowed;opacity:.5}.status{font-weight:800}.ok{color:var(--good)}.bad{color:var(--bad)}.warn{color:var(--warn)}
    #|.summary-ribbon{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:17px}.metric{min-width:0;border:1px solid var(--line);border-radius:14px;padding:13px;background:var(--bg)}.metric h3{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.metric strong{display:block;font-size:20px;overflow-wrap:anywhere}.evidence-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:14px;margin-top:14px}.evidence{min-width:0;border:1px solid var(--line);border-radius:14px;padding:15px}.event-compare,.diff-compare{display:grid;grid-template-columns:1fr 1fr;gap:10px}.evidence-card{min-width:0;border-radius:12px;padding:12px;background:var(--bg);border:1px solid var(--line)}.evidence-card.expected{border-color:var(--good)}.evidence-card.actual{border-color:var(--bad)}.evidence-card h4{margin:0 0 7px}.evidence-card pre,.evidence pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.5 ui-monospace,monospace}.focus-strip{display:flex;gap:7px;overflow-x:auto;padding:6px 1px 3px}.focus-step{min-width:76px;border:1px solid var(--line);border-radius:10px;padding:9px;text-align:center;background:var(--bg)}.focus-step.active{border-color:var(--bad);background:var(--bad-soft);color:var(--bad);font-weight:800}.focus-step small{display:block;color:var(--muted)}
    #|.split{display:grid;grid-template-columns:minmax(300px,1fr) minmax(360px,1.3fr);gap:16px}.debug-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:16px}.drop{border:2px dashed var(--line);border-radius:12px;padding:12px;text-align:center}.drop.over{border-color:var(--accent)}textarea{width:100%;min-height:270px;resize:vertical;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:12px;font:12px/1.45 ui-monospace,monospace}.compact{min-height:125px}details>summary{cursor:pointer;font-size:18px;font-weight:750;padding:14px 0}#stage{min-height:150px;display:grid;align-content:center}.sequence{display:flex;gap:10px;flex-wrap:wrap}.item{min-width:58px;border:2px solid var(--line);border-radius:11px;padding:10px;text-align:center}.item small{display:block;color:var(--muted)}.set-groups{display:flex;gap:8px;flex-wrap:wrap}.set-group{border:1px solid var(--line);border-radius:10px;padding:9px}.grid-view{display:grid;gap:5px;max-width:560px}.grid-cell{min-width:42px;min-height:42px;border:1px solid var(--line);border-radius:7px;display:grid;place-items:center}.grid-cell.blocked{background:#111827;color:white}[data-role=current]{background:#f59e0b;color:#111827}[data-role=compared]{background:#c084fc;color:#111827}[data-role=changed]{background:#fb7185;color:#111827}[data-role=result]{background:#4ade80;color:#111827}[data-role=error]{background:#ef4444;color:white}.timeline,.debug-list{max-height:220px;overflow:auto;font:13px/1.5 ui-monospace,monospace}.timeline button{display:block;width:100%;text-align:left;border:0;border-radius:6px;padding:5px 8px}.timeline button.active{color:var(--accent);background:var(--accent-soft);font-weight:800}.debug-list button{display:block;width:100%;text-align:left;margin:5px 0}.errors{white-space:pre-wrap;color:var(--bad);font:13px/1.45 ui-monospace,monospace}.badge{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:3px 8px;margin:3px;color:var(--muted)}input[type=range]{flex:1;min-width:150px;accent-color:var(--accent)}
