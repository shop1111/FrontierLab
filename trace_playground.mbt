///|
/// Render a self-contained offline playground for importing, validating,
/// analyzing, replaying, and exporting schema-v1 trace documents.
pub fn render_trace_playground() -> String raise TraceError {
  let example = insertion_sort_trace([5, 2, 4, 1, 3])
  let safe_example = example.encode_json().replace_all(old="<", new="\\u003c")
  let out = StringBuilder()
  out.write_string(
    (
      #|<!doctype html>
      #|<html lang="en"><head><meta charset="utf-8">
      #|<meta name="viewport" content="width=device-width,initial-scale=1">
      #|<title>FrontierLab Semantic Time-Travel Debugger</title>
      #|<style>
      #|:root{color-scheme:light dark;--bg:#f8fafc;--panel:#fff;--ink:#0f172a;--muted:#64748b;--line:#cbd5e1;--accent:#2563eb;--bad:#dc2626;--good:#15803d}
      #|@media(prefers-color-scheme:dark){:root{--bg:#07111f;--panel:#0f172a;--ink:#f8fafc;--muted:#94a3b8;--line:#334155;--accent:#60a5fa;--bad:#f87171;--good:#4ade80}}
      #|*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,sans-serif}main{max-width:1280px;margin:auto;padding:24px}h1{margin:.1em 0;font-size:clamp(30px,6vw,56px)}h2,h3{margin:.25em 0}.muted{color:var(--muted)}.toolbar,.controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px;margin-top:16px}.split{display:grid;grid-template-columns:minmax(300px,1fr) minmax(360px,1.35fr);gap:16px}.debug-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}.drop{border:2px dashed var(--line);border-radius:12px;padding:12px;text-align:center}.drop.over{border-color:var(--accent)}textarea{width:100%;min-height:330px;resize:vertical;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:12px;font:12px/1.45 ui-monospace,monospace}.compact{min-height:130px}button,input,select{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:8px 11px}button{cursor:pointer}button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}button:hover{border-color:var(--accent)}input[type=range]{flex:1;min-width:150px;accent-color:var(--accent)}.status{font-weight:700}.ok{color:var(--good)}.bad{color:var(--bad)}.errors{white-space:pre-wrap;color:var(--bad);font:13px/1.45 ui-monospace,monospace}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:9px;margin-top:12px}.card{border:1px solid var(--line);border-radius:11px;padding:10px}.card strong{display:block;font-size:22px}.badges{display:flex;gap:7px;flex-wrap:wrap}.badge{border:1px solid var(--line);border-radius:99px;padding:3px 8px;color:var(--muted)}#stage{min-height:280px;display:grid;gap:16px}.object h3{margin-bottom:9px}.sequence{display:flex;gap:9px;flex-wrap:wrap}.item,.group,.cell,.node{border:2px solid var(--line);border-radius:9px;padding:10px;text-align:center}.item{min-width:54px}.item small{display:block;color:var(--muted)}.groups{display:grid;gap:7px}.grid{display:grid;gap:3px;width:max-content}.cell{width:40px;height:40px;padding:7px}.blocked{background:#334155;color:white}[data-role=current]{background:#f59e0b}[data-role=candidate]{background:#38bdf8}[data-role=compared]{background:#c084fc}[data-role=changed]{background:#fb7185}[data-role=visited]{background:#93c5fd}[data-role=frontier]{background:#22d3ee}[data-role=result]{background:#4ade80}[data-role=error]{background:#ef4444}.timeline,.debug-list{max-height:240px;overflow:auto;font:13px/1.5 ui-monospace,monospace}.timeline div.active,.debug-list button.active{color:var(--accent);font-weight:700}.debug-list button{display:block;width:100%;text-align:left;margin:5px 0}.quality li{margin:4px 0}@media(max-width:850px){.split{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
      #|</style></head><body><main>
      #|<a href="index.html">← FrontierLab demos</a><h1>Semantic Time-Travel Debugger</h1><p class="muted">Debug instrumented algorithms and AI-generated traces with semantic breakpoints, frame diffs, contracts, and first-divergence analysis. Everything stays in this browser.</p>
      #|<div class="split"><section class="panel"><div id="drop" class="drop">Drop a JSON file here or choose one <input id="file" type="file" accept=".json,application/json"></div><textarea id="source" spellcheck="false" aria-label="Trace JSON"></textarea><div class="toolbar"><button id="load" class="primary">Validate &amp; load</button><button id="validExample">Valid example</button><button id="faultyExample">Faulty sort</button><button id="invalidExample">Invalid JSON shape</button><button id="downloadJson">Download JSON</button></div><p id="status" class="status"></p><div id="errors" class="errors"></div></section>
      #|<section><section class="panel"><div class="controls"><button id="prev">← Prev</button><button id="play">Play</button><button id="next">Next →</button><input id="range" type="range" min="0" value="0"><select id="speed"><option value="1200">0.5×</option><option value="650" selected>1×</option><option value="300">2×</option></select><output id="counter"></output><button id="downloadSvg">Export current SVG</button></div></section><section id="stage" class="panel" aria-live="polite"></section><section class="panel"><h2 id="traceTitle">No trace loaded</h2><p id="event" class="muted"></p><div id="eventBadges" class="badges"></div><div id="cards" class="cards"></div></section></section></div>
      #|<div class="debug-grid"><section class="panel"><h2>Frame diff</h2><p class="muted">Changes from the previous frame.</p><div id="frameDiff" class="debug-list"></div></section><section class="panel"><h2>Semantic breakpoints</h2><div class="toolbar"><input id="bpEvent" placeholder="event kind"><input id="bpTarget" placeholder="object/entity"><input id="bpRole" placeholder="highlight role"><label><input id="bpChanged" type="checkbox"> changed only</label><button id="findBreakpoints">Find</button></div><div id="breakpointHits" class="debug-list"></div></section><section class="panel"><h2>Trace contract</h2><div class="toolbar"><select id="contract"><option value="sequence-transition">sequence-transition</option><option value="insertion-sort-int">insertion-sort-int</option><option value="grid-path">grid-path</option></select><input id="contractObject" value="values" aria-label="Contract object id"><button id="runContract" class="primary">Verify</button><button id="downloadCounterexample">Counterexample</button></div><div id="contractResult" class="debug-list"></div></section></div>
      #|<div class="split"><section class="panel"><h2>First divergence</h2><p class="muted">Paste an expected/reference trace and compare it with the loaded actual trace.</p><textarea id="expectedSource" class="compact" spellcheck="false" aria-label="Expected trace JSON"></textarea><button id="findDivergence">Find first divergence</button><div id="divergenceResult" class="debug-list"></div></section><section class="panel"><h2>Quality diagnostics</h2><ul id="quality" class="quality"></ul><h2>Timeline</h2><div id="timeline" class="timeline"></div></section></div>
      #|<script id="valid-data" type="application/json">
    ),
  )
  out.write_string(safe_example)
  out.write_string(
    (
      #|</script><script>
      #|(()=>{'use strict';const $=id=>document.getElementById(id),source=$('source');let data=null,index=-1,timer=null,lastViolations=[];const valid=$('valid-data').textContent.trim();const invalid='{"schema_version":"1.0","metadata":{"title":"Broken"},"steps":[{"index":3}]}';function faultyTrace(){const d=JSON.parse(valid),items=d.steps[0].scene.objects.find(o=>o.id==='values').items;[items[0],items[1]]=[items[1],items[0]];d.metadata.title='Faulty AI-generated insertion sort';return JSON.stringify(d,null,2)}source.value=valid;$('expectedSource').value=valid;
      #|const err=(a,p,m)=>a.push(`${p}: ${m}`);function validate(d){const e=[];if(!d||typeof d!=='object'||Array.isArray(d)){err(e,'$','expected an object');return e}if(d.schema_version!=='1.0')err(e,'$.schema_version','expected "1.0"');if(!d.metadata||typeof d.metadata!=='object')err(e,'$.metadata','missing metadata object');else{if(typeof d.metadata.title!=='string'||!d.metadata.title.trim())err(e,'$.metadata.title','expected a non-empty string');if(typeof d.metadata.algorithm!=='string'||!d.metadata.algorithm.trim())err(e,'$.metadata.algorithm','expected a non-empty string')}sceneErrors(d.initial_scene,'$.initial_scene',e);if(!Array.isArray(d.steps))err(e,'$.steps','expected an array');else d.steps.forEach((s,i)=>{if(!s||typeof s!=='object'){err(e,`$.steps[${i}]`,'expected an object');return}if(s.index!==i)err(e,`$.steps[${i}].index`,`expected ${i}`);if(!s.event||typeof s.event.type!=='string')err(e,`$.steps[${i}].event.type`,'expected an event type');sceneErrors(s.scene,`$.steps[${i}].scene`,e)});return e}
      #|function sceneErrors(s,p,e){if(!s||typeof s!=='object'){err(e,p,'expected a scene object');return}if(!Array.isArray(s.objects))err(e,p+'.objects','expected an array');if(s.highlights!==undefined&&!Array.isArray(s.highlights))err(e,p+'.highlights','expected an array')}
      #|function eventTargets(ev){if(!ev)return[];return ev.targets||[ev.target,ev.left,ev.right,ev.from,ev.to].filter(Boolean)}function entities(o){return o.items?.length||o.groups?.length||o.nodes?.length||o.cells?.length||0}function analyze(d){const counts={},targets={};let maxObjects=d.initial_scene.objects.length,maxEntities=d.initial_scene.objects.reduce((n,o)=>n+entities(o),0),annotations=0,highlights=(d.initial_scene.highlights||[]).length;for(const s of d.steps){counts[s.event.type]=(counts[s.event.type]||0)+1;for(const t of eventTargets(s.event)){const k=`${t.object_id}/${t.entity_id||'*'}`;targets[k]=(targets[k]||0)+1}maxObjects=Math.max(maxObjects,s.scene.objects.length);maxEntities=Math.max(maxEntities,s.scene.objects.reduce((n,o)=>n+entities(o),0));annotations+=s.annotation?1:0;highlights+=(s.scene.highlights||[]).length}return{counts,targets,maxObjects,maxEntities,annotations,highlights,completed:d.steps.at(-1)?.event?.type==='complete'}}
      #|function lint(d){const q=[];if(!d.initial_scene.objects.length)q.push(['warning','Initial scene has no renderable objects.']);if(!d.steps.length)q.push(['warning','Trace has no recorded steps.']);else if(d.steps.at(-1).event.type!=='complete')q.push(['warning','The final event is not complete.']);if(!d.summary||!Object.keys(d.summary).length)q.push(['info','Trace has no summary attributes.']);d.steps.forEach((s,i)=>{if(!s.annotation&&s.event.type!=='complete')q.push(['info',`Step ${i} has no teaching annotation.`]);if(!s.scene.objects.length)q.push(['warning',`Step ${i} has an empty scene.`])});return q}
      #|function frame(d,n){return n<0?d.initial_scene:d.steps[n].scene}function entityRows(o){if(o.type==='sequence')return(o.items||[]).map((x,i)=>[x.id,x.value,i]);if(o.type==='sets')return(o.groups||[]).map((x,i)=>[x.id,`${x.label}:${(x.members||[]).join(',')}`,i]);if(o.type==='graph')return[...(o.nodes||[]).map((x,i)=>[x.id,x.label,i]),...(o.edges||[]).map((x,i)=>[`edge:${x.id}`,`${x.from}->${x.to}:${x.label||''}`,i+(o.nodes||[]).length])];if(o.type==='grid')return(o.cells||[]).map((x,i)=>[x.id,`${x.x},${x.y}:${x.label||''}:${!!x.blocked}`,i]);return[]}function sceneDiff(a,b){const c=[],bm=Object.fromEntries((b.objects||[]).map(o=>[o.id,o]));for(const o of a.objects||[]){const n=bm[o.id];if(!n){c.push({kind:'removed',target:o.id});continue}const next=Object.fromEntries(entityRows(n).map(x=>[x[0],x]));for(const x of entityRows(o)){const y=next[x[0]];if(!y)c.push({kind:'removed',target:`${o.id}/${x[0]}`,before:x[1]});else if(x[1]!==y[1])c.push({kind:'updated',target:`${o.id}/${x[0]}`,before:x[1],after:y[1]});else if(x[2]!==y[2])c.push({kind:'moved',target:`${o.id}/${x[0]}`,before_index:x[2],after_index:y[2]})}const old=Object.fromEntries(entityRows(o).map(x=>[x[0],x]));for(const y of entityRows(n))if(!old[y[0]])c.push({kind:'added',target:`${o.id}/${y[0]}`,after:y[1]})}const am=Object.fromEntries((a.objects||[]).map(o=>[o.id,o]));for(const o of b.objects||[])if(!am[o.id])c.push({kind:'added',target:o.id});const hk=h=>`${h.target.object_id}/${h.target.entity_id||'*'}:${h.role}`,ah=(a.highlights||[]).map(hk),bh=(b.highlights||[]).map(hk);for(const x of ah)if(!bh.includes(x))c.push({kind:'highlight-removed',target:x});for(const x of bh)if(!ah.includes(x))c.push({kind:'highlight-added',target:x});return c}
      #|function sequenceViolations(d,id,checkSorted){const v=[],seq=s=>(s.objects||[]).find(o=>o.type==='sequence'&&o.id===id);let before=seq(d.initial_scene);if(!before)return[{step:-1,code:'missing-sequence',message:`Missing sequence ${id}`}];for(const step of d.steps){const after=seq(step.scene);if(!after){v.push({step:step.index,code:'sequence-disappeared',message:`Sequence ${id} disappeared`});continue}const bi=before.items.map(x=>x.id),ai=after.items.map(x=>x.id),values=Object.fromEntries(before.items.map(x=>[x.id,x.value]));for(const x of after.items)if(values[x.id]!==x.value)v.push({step:step.index,code:'stable-value-changed',message:`${x.id} changed stable value`});if(step.event.type==='compare'&&bi.join()!=ai.join())v.push({step:step.index,code:'compare-mutated-order',message:'Compare changed sequence order'});if(step.event.type==='swap'){const l=step.event.left?.entity_id,r=step.event.right?.entity_id,expected=[...bi],a=expected.indexOf(l),b=expected.indexOf(r);if(a>=0&&b>=0)[expected[a],expected[b]]=[expected[b],expected[a]];if(expected.join()!=ai.join())v.push({step:step.index,code:'invalid-swap-transition',message:'Swap did not match its declared entities'})}before=after}if(checkSorted&&before){const nums=before.items.map(x=>Number(x.value));for(let i=1;i<nums.length;i++)if(!Number.isFinite(nums[i-1])||!Number.isFinite(nums[i])||nums[i-1]>nums[i]){v.push({step:d.steps.length-1,code:'result-not-sorted',message:`Final inversion near index ${i}`});break}}return v}
      #|function gridViolations(d,id){const v=[],s=d.steps.length?d.steps.at(-1).scene:d.initial_scene,g=s.objects.find(o=>o.type==='grid'&&o.id===id);if(!g)return[{step:-1,code:'missing-grid',message:`Missing grid ${id}`}];const map=Object.fromEntries(g.cells.map(c=>[c.id,c])),ids=(s.highlights||[]).filter(h=>h.role==='result'&&h.target.object_id===id).map(h=>h.target.entity_id),cells=ids.map(x=>map[x]).filter(Boolean);for(const c of cells)if(c.blocked)v.push({step:d.steps.length-1,code:'path-crosses-blocked-cell',message:`Path crosses ${c.id}`});for(let i=1;i<cells.length;i++)if(Math.abs(cells[i-1].x-cells[i].x)+Math.abs(cells[i-1].y-cells[i].y)!==1){v.push({step:d.steps.length-1,code:'non-contiguous-path',message:'Result path is not contiguous'});break}if(cells.length&&cells[0].label!=='S')v.push({step:d.steps.length-1,code:'path-start-mismatch',message:'Path does not begin at S'});if(cells.length&&cells.at(-1).label!=='E')v.push({step:d.steps.length-1,code:'path-end-mismatch',message:'Path does not end at E'});return v}
      #|function counterexample(d,focus,before=2,after=2){const start=Math.max(0,focus-before),end=Math.min(d.steps.length-1,focus+after),initial=start?d.steps[start-1].scene:d.initial_scene,steps=d.steps.slice(start,end+1).map((s,i)=>({...s,index:i}));return{...d,metadata:{...d.metadata,title:`${d.metadata.title} counterexample`,description:`Original steps ${start}..${end}; focus ${focus}`},initial_scene:initial,steps,summary:[{key:'original_start',value:String(start)},{key:'original_focus',value:String(focus)},{key:'original_end',value:String(end)}]}}
