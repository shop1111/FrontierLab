///|
/// Render the self-contained AI Trace Clinic.
///
/// The page intentionally has no framework, server, or external asset. Its
/// default evidence mirrors `fixtures/agent-traces`: a selection-sort trace
/// whose stale-index swap first diverges at step 10.
pub fn render_trace_playground() -> String raise TraceError {
  // Preserve the established fallible API while validating the empty clinic
  // shell with the same scene rules used by imported traces.
  ignore(Scene::new(objects=[]))
  (
    #|<!doctype html>
    #|<html lang="en"><head><meta charset="utf-8">
    #|<meta name="viewport" content="width=device-width,initial-scale=1">
    #|<title>FrontierLab AI Trace Clinic</title>
    #|<style>
    #|:root{color-scheme:light dark;--bg:#f7f8fc;--panel:#fff;--ink:#172033;--muted:#64748b;--line:#d8dced;--accent:#6d28d9;--bad:#b91c1c;--good:#047857;--warn:#b45309}
    #|@media(prefers-color-scheme:dark){:root{--bg:#090d18;--panel:#121827;--ink:#f8fafc;--muted:#a6b0c4;--line:#334155;--accent:#a78bfa;--bad:#fca5a5;--good:#6ee7b7;--warn:#fcd34d}}
    #|*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 system-ui,sans-serif}main{max-width:1180px;margin:auto;padding:24px}h1{margin:.1em 0;font-size:clamp(34px,6vw,62px);letter-spacing:-.04em}h2,h3{margin:.2em 0}.hero{padding:32px 0 12px}.eyebrow{color:var(--accent);font-weight:800;text-transform:uppercase;letter-spacing:.12em}.muted{color:var(--muted)}.panel{min-width:0;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;margin-top:16px;box-shadow:0 14px 40px #1111}.toolbar,.controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.toolbar>*{max-width:100%}button,input,select{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px}button{cursor:pointer;font-weight:650}button.primary{background:var(--accent);border-color:var(--accent);color:white}button:hover{border-color:var(--accent)}.results{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}.result{min-width:0;min-height:145px;border:1px solid var(--line);border-radius:14px;padding:14px}.result h3{font-size:14px;color:var(--muted)}.result pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.45 ui-monospace,monospace}.ok{color:var(--good)}.bad{color:var(--bad)}.warn{color:var(--warn)}.status{font-weight:750}.split{display:grid;grid-template-columns:minmax(300px,1fr) minmax(360px,1.3fr);gap:16px}.debug-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:16px}.drop{border:2px dashed var(--line);border-radius:12px;padding:12px;text-align:center}.drop.over{border-color:var(--accent)}textarea{width:100%;min-height:270px;resize:vertical;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:12px;font:12px/1.45 ui-monospace,monospace}.compact{min-height:125px}details>summary{cursor:pointer;font-size:18px;font-weight:750;padding:14px 0}#stage{min-height:150px;display:grid;align-content:center}.sequence{display:flex;gap:10px;flex-wrap:wrap}.item{min-width:58px;border:2px solid var(--line);border-radius:11px;padding:10px;text-align:center}.item small{display:block;color:var(--muted)}[data-role=current]{background:#f59e0b;color:#111827}[data-role=compared]{background:#c084fc;color:#111827}[data-role=changed]{background:#fb7185;color:#111827}[data-role=result]{background:#4ade80;color:#111827}[data-role=error]{background:#ef4444;color:white}.timeline,.debug-list{max-height:220px;overflow:auto;font:13px/1.5 ui-monospace,monospace}.timeline div.active{color:var(--accent);font-weight:800}.debug-list button{display:block;width:100%;text-align:left;margin:5px 0}.errors{white-space:pre-wrap;color:var(--bad);font:13px/1.45 ui-monospace,monospace}.badge{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:3px 8px;margin:3px;color:var(--muted)}input[type=range]{flex:1;min-width:150px;accent-color:var(--accent)}@media(max-width:850px){.results{grid-template-columns:1fr 1fr}.split{grid-template-columns:minmax(0,1fr)}}@media(max-width:520px){main{padding:14px}.results{grid-template-columns:minmax(0,1fr)}.hero{padding-top:18px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
    #|</style></head><body><main>
    #|<header class="hero"><div class="eyebrow">FrontierLab AI Trace Clinic</div><h1>Semantic Time-Travel Debugger</h1><p class="muted">Turn an opaque wrong trace into a contract failure, the first divergence, the changed state, and a portable minimal counterexample — in one click, fully offline.</p></header>
    #|<section class="panel" aria-labelledby="clinic-title"><h2 id="clinic-title">Diagnose a trace</h2><div class="toolbar"><label>Case <select id="caseSelect"><option value="faulty" selected>Faulty selection sort (step 10)</option><option value="correct">Correct selection sort</option><option value="custom">Custom imported trace</option></select></label><button id="runDiagnosis" class="primary">Run diagnosis</button><span id="clinicStatus" class="status muted">Ready: published-package evidence is loaded.</span></div>
    #|<div class="results" aria-live="polite"><article class="result"><h3>1. Schema / contract</h3><pre id="schemaResult">Not run</pre></article><article class="result"><h3>2. First divergence</h3><pre id="divergenceSummary">Not run</pre></article><article class="result"><h3>3. State changes</h3><pre id="stateSummary">Not run</pre></article><article class="result"><h3>4. Minimal counterexample</h3><pre id="counterexampleSummary">Not run</pre></article></div>
    #|<div class="toolbar" style="margin-top:14px"><button id="downloadCounterexample">Download minimal counterexample JSON</button><button id="downloadReport">Download diagnostic HTML</button><button id="copyRepair">Copy repair prompt</button><span id="actionStatus" class="status muted"></span></div></section>
    #|<section class="panel"><h2 id="traceTitle">Faulty selection sort - stale index</h2><p id="event" class="muted">Run diagnosis to jump to the first bad step.</p><div id="stage"></div></section>
    #|<details id="advanced"><summary>Advanced details</summary>
    #|<div class="split"><section class="panel"><div id="drop" class="drop">Drop a JSON file here or choose one <input id="file" type="file" accept=".json,application/json"></div><label>Actual trace JSON<textarea id="source" spellcheck="false" aria-label="Trace JSON"></textarea></label><div class="toolbar"><button id="load" class="primary">Validate &amp; load</button><button id="validExample">Valid example</button><button id="faultyExample">Faulty sort</button><button id="invalidExample">Invalid JSON shape</button><button id="downloadJson">Download JSON</button></div><p id="status" class="status"></p><div id="errors" class="errors"></div></section>
    #|<section class="panel"><div class="controls"><button id="prev">Prev</button><button id="play">Play</button><button id="next">Next</button><input id="range" type="range" min="0" value="0"><select id="speed"><option value="1200">0.5x</option><option value="650" selected>1x</option><option value="300">2x</option></select><output id="counter"></output><button id="downloadSvg">Export current SVG</button></div><div id="frameDiff" class="debug-list"></div></section></div>
    #|<div class="debug-grid"><section class="panel"><h2>Semantic breakpoints</h2><div class="toolbar"><input id="bpEvent" placeholder="event kind"><input id="bpTarget" placeholder="object/entity"><input id="bpRole" placeholder="highlight role"><label><input id="bpChanged" type="checkbox"> changed only</label><button id="findBreakpoints">Find</button></div><div id="breakpointHits" class="debug-list"></div></section>
    #|<section class="panel"><h2>Trace contract</h2><div class="toolbar"><select id="contract"><option value="sequence-transition">sequence-transition</option><option value="insertion-sort-int" selected>insertion-sort-int</option><option value="grid-path">grid-path</option></select><input id="contractObject" value="values" aria-label="Contract object id"><button id="runContract">Verify</button></div><div id="contractResult" class="debug-list"></div></section>
    #|<section class="panel"><h2>First divergence</h2><textarea id="expectedSource" class="compact" spellcheck="false" aria-label="Expected trace JSON"></textarea><button id="findDivergence">Find first divergence</button><div id="divergenceResult" class="debug-list"></div></section></div>
    #|<div class="split"><section class="panel"><h2>Quality diagnostics</h2><ul id="quality"></ul></section><section class="panel"><h2>Timeline</h2><div id="timeline" class="timeline"></div></section></div></details>
    #|<script>
    #|(()=>{'use strict';const $=id=>document.getElementById(id),clone=x=>JSON.parse(JSON.stringify(x)),ref=id=>({object_id:'values',entity_id:id}),invalid='{"schema_version":"1.0","metadata":{"title":"Broken"},"steps":[{"index":3}]}';let data=null,index=-1,timer=null,lastDiagnosis=null;
    #|function selectionTrace(faulty){const working=[5,2,4,1,3].map((value,i)=>({id:`item-${i}`,value})),scene=(roles=[])=>({objects:[{type:'sequence',id:'values',label:'Selection sort',items:working.map(x=>({id:x.id,value:String(x.value)}))}],highlights:roles.map(([id,role])=>({target:ref(id),role}))}),steps=[],record=(event,roles,title,body)=>steps.push({index:steps.length,event,scene:clone(scene(roles)),annotation:{title,body,pseudocode_line:event.type==='compare'?3:5}}),initial=clone(scene());for(let i=0;i<working.length;i++){let minimum=i;for(let j=i+1;j<working.length;j++){const a=working[minimum],b=working[j];record({type:'compare',targets:[ref(a.id),ref(b.id)]},[[a.id,'compared'],[b.id,'current']],'Compare candidate',`Pass ${i}: compare ${a.value} with ${b.value}.`);if(b.value<a.value)minimum=j}if(minimum!==i){const swapIndex=faulty&&i===2?3:minimum,left=working[i],selected=working[swapIndex];working[i]=selected;working[swapIndex]=left;record({type:'swap',left:ref(left.id),right:ref(selected.id)},[[left.id,faulty&&i===2?'error':'changed'],[selected.id,'result']],faulty&&i===2?'Stale-index fault':'Place minimum',faulty&&i===2?'Expected item-4 (3), but stale index 3 selected item-0 (5).':`Place ${selected.value} at sorted position ${i}.`)}}steps.push({index:steps.length,event:{type:'complete'},scene:clone(scene(working.map(x=>[x.id,faulty?'error':'result']))),annotation:{title:faulty?'Incorrect result':'Sorted',body:`Final values: ${working.map(x=>x.value).join(',')}.`}});return{format:'frontierlab-trace',schema_version:'1.0',metadata:{title:faulty?'Faulty selection sort - stale index':'Expected selection sort',algorithm:'selection-sort',description:'Published-package consumer trace with stable entity ids.'},initial_scene:initial,steps,summary:[{key:'consumer_dependency',value:'shop1111/frontierlab@0.6.0'},{key:'fault_injected',value:String(faulty)}]}}
    #|const expectedFixture=selectionTrace(false),actualFixture=selectionTrace(true);function err(a,p,m){a.push(`${p}: ${m}`)}function validate(d){const e=[];if(!d||typeof d!=='object'||Array.isArray(d)){err(e,'$','expected an object');return e}if(d.format!=='frontierlab-trace')err(e,'$.format','expected "frontierlab-trace"');if(d.schema_version!=='1.0')err(e,'$.schema_version','expected "1.0"');if(!d.metadata||typeof d.metadata.title!=='string'||typeof d.metadata.algorithm!=='string')err(e,'$.metadata','title and algorithm are required');sceneErrors(d.initial_scene,'$.initial_scene',e);if(!Array.isArray(d.steps))err(e,'$.steps','expected an array');else d.steps.forEach((s,i)=>{if(s?.index!==i)err(e,`$.steps[${i}].index`,`expected ${i}`);if(typeof s?.event?.type!=='string')err(e,`$.steps[${i}].event.type`,'expected an event type');sceneErrors(s?.scene,`$.steps[${i}].scene`,e);const objects=new Map((s?.scene?.objects||[]).map(o=>[o.id,new Set(entityRows(o).map(x=>x[0]))]));for(const t of eventTargets(s?.event)){if(!objects.has(t.object_id))err(e,`$.steps[${i}].event` ,`unknown object ${t.object_id}`);else if(t.entity_id&&!objects.get(t.object_id).has(t.entity_id))err(e,`$.steps[${i}].event`,`unknown entity ${t.object_id}/${t.entity_id}`)}});return e}function sceneErrors(s,p,e){if(!s||typeof s!=='object'){err(e,p,'expected a scene object');return}if(!Array.isArray(s.objects))err(e,p+'.objects','expected an array');if(s.highlights!==undefined&&!Array.isArray(s.highlights))err(e,p+'.highlights','expected an array')}
    #|function eventTargets(e){return e?.targets||[e?.target,e?.left,e?.right,e?.from,e?.to].filter(Boolean)}function entityRows(o){if(o.type==='sequence')return(o.items||[]).map((x,i)=>[x.id,x.value,i]);if(o.type==='sets')return(o.groups||[]).map((x,i)=>[x.id,`${x.label}:${(x.members||[]).join(',')}`,i]);if(o.type==='graph')return[...(o.nodes||[]).map((x,i)=>[x.id,x.label,i]),...(o.edges||[]).map((x,i)=>[`edge:${x.id}`,`${x.from}->${x.to}`,i+(o.nodes||[]).length])];if(o.type==='grid')return(o.cells||[]).map((x,i)=>[x.id,`${x.x},${x.y}:${x.label||''}:${!!x.blocked}`,i]);return[]}function analyze(d){const counts={};let maxObjects=d.initial_scene.objects.length,maxEntities=d.initial_scene.objects.reduce((n,o)=>n+entityRows(o).length,0);for(const s of d.steps){counts[s.event.type]=(counts[s.event.type]||0)+1;maxObjects=Math.max(maxObjects,s.scene.objects.length);maxEntities=Math.max(maxEntities,s.scene.objects.reduce((n,o)=>n+entityRows(o).length,0))}return{counts,maxObjects,maxEntities,completed:d.steps.at(-1)?.event?.type==='complete'}}function lint(d){const q=[];if(!d.steps.length)q.push(['warning','Trace has no recorded steps.']);else if(d.steps.at(-1).event.type!=='complete')q.push(['warning','The final event is not complete.']);if(!(d.summary||[]).length)q.push(['info','Trace has no summary attributes.']);return q}
    #|function frame(d,n){return n<0?d.initial_scene:d.steps[n].scene}function sceneDiff(a,b){const changes=[],bm=Object.fromEntries((b.objects||[]).map(o=>[o.id,o]));for(const o of a.objects||[]){const n=bm[o.id];if(!n){changes.push({kind:'removed',target:o.id});continue}const next=Object.fromEntries(entityRows(n).map(x=>[x[0],x]));for(const x of entityRows(o)){const y=next[x[0]];if(!y)changes.push({kind:'removed',target:`${o.id}/${x[0]}`});else if(x[1]!==y[1])changes.push({kind:'updated',target:`${o.id}/${x[0]}`,before:x[1],after:y[1]});else if(x[2]!==y[2])changes.push({kind:'moved',target:`${o.id}/${x[0]}`,before_index:x[2],after_index:y[2]})}const old=Object.fromEntries(entityRows(o).map(x=>[x[0],x]));for(const y of entityRows(n))if(!old[y[0]])changes.push({kind:'added',target:`${o.id}/${y[0]}`})}for(const o of b.objects||[])if(!(a.objects||[]).some(x=>x.id===o.id))changes.push({kind:'added',target:o.id});return changes}
    #|function sequenceViolations(d,id,sorted){const v=[],seq=s=>(s.objects||[]).find(o=>o.type==='sequence'&&o.id===id);let before=seq(d.initial_scene);if(!before)return[{step:-1,code:'missing-sequence',message:`Missing sequence ${id}.`}];for(const step of d.steps){const after=seq(step.scene);if(!after){v.push({step:step.index,code:'sequence-disappeared',message:`Sequence ${id} disappeared.`});continue}const bi=before.items.map(x=>x.id),ai=after.items.map(x=>x.id),values=Object.fromEntries(before.items.map(x=>[x.id,x.value]));for(const x of after.items)if(values[x.id]!==x.value)v.push({step:step.index,code:'stable-value-changed',message:`${x.id} changed stable value.`});if(step.event.type==='compare'&&bi.join()!=ai.join())v.push({step:step.index,code:'compare-mutated-order',message:'Compare changed sequence order.'});if(step.event.type==='swap'){const expected=[...bi],a=expected.indexOf(step.event.left?.entity_id),b=expected.indexOf(step.event.right?.entity_id);if(a>=0&&b>=0)[expected[a],expected[b]]=[expected[b],expected[a]];if(expected.join()!=ai.join())v.push({step:step.index,code:'invalid-swap-transition',message:'Swap did not match declared entities.'})}before=after}if(sorted&&before){const nums=before.items.map(x=>Number(x.value));for(let i=1;i<nums.length;i++)if(!Number.isFinite(nums[i-1])||!Number.isFinite(nums[i])||nums[i-1]>nums[i]){v.push({step:d.steps.length-1,code:'result-not-sorted',message:`Final inversion ${nums[i-1]} > ${nums[i]} near index ${i}.`});break}}return v}function gridViolations(){return[{step:-1,code:'clinic-grid-note',message:'Use the CLI for authoritative grid-path diagnosis.'}]}
