e}',rightChild:'right child {value}',red:'red',black:'black',current:'Current',candidate:'Candidate',compared:'Compared',changed:'Changed',visited:'Visited',frontier:'Frontier',result:'Result',error:'Error',object:'object',noAnnotation:'No additional annotation for this step.'}};
    #|const format=(template,values)=>Object.entries(values).reduce((text,[key,value])=>text.replaceAll(`{${key}}`,value),template);
    #|const targetKey=target=>`${target.object_id}::${target.entity_id||''}`;
    #|const objectAt=(scene,id)=>(scene?.objects||[]).find(object=>object.id===id);
    #|function entityInfo(scene,target){const object=objectAt(scene,target.object_id);if(!object)return{key:targetKey(target),label:target.entity_id||target.object_id,value:'?',index:-1,kind:'missing'};if(!target.entity_id)return{key:targetKey(target),label:object.label||object.id,value:object.label||object.id,index:-1,kind:object.type};if(object.type==='sequence'){const index=object.items.findIndex(item=>item.id===target.entity_id),item=object.items[index];return{key:targetKey(target),label:item?.label||item?.value||target.entity_id,value:item?.value??'?',index,kind:'sequence'}}if(object.type==='sets'){const index=object.groups.findIndex(group=>group.id===target.entity_id),group=object.groups[index];if(group)return{key:targetKey(target),label:group.label||target.entity_id,value:group.members.join(', '),index,kind:'sets'};const parentIndex=object.groups.findIndex(value=>value.members.includes(target.entity_id)),parent=object.groups[parentIndex];return{key:targetKey(target),label:target.entity_id,value:parent?.label||'?',index:parentIndex,kind:'set-member'}}if(object.type==='graph'){const index=object.nodes.findIndex(node=>node.id===target.entity_id),node=object.nodes[index];return{key:targetKey(target),label:node?.label||target.entity_id,value:node?.label||'?',index,kind:'graph'}}if(object.type==='grid'){const index=object.cells.findIndex(cell=>cell.id===target.entity_id),cell=object.cells[index];return{key:targetKey(target),label:cell?.label||target.entity_id,value:cell?.label||'',index,x:cell?.x,y:cell?.y,kind:'grid'}}return{key:targetKey(target),label:target.entity_id,value:'?',index:-1,kind:object.type}}
    #|const describe=(info,lang)=>{const dict=TEXT[lang];if(info.kind==='sequence')return `${info.label}（${dict.index} ${info.index}，${dict.value} ${info.value}）`;if(info.kind==='grid'&&info.x!==undefined)return `(${info.x}, ${info.y})${info.value?` = ${info.value}`:''}`;return info.value&&info.value!==info.label?`${info.label}（${info.value}）`:info.label};
